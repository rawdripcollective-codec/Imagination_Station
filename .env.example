# =============================================================================
# Imagination Station — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Imagination Station

# -----------------------------------------------------------------------------
# AI Provider API Keys (Cloud Models)
# -----------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google AI — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIza...

# Mistral AI — https://console.mistral.ai/
MISTRAL_API_KEY=...

# -----------------------------------------------------------------------------
# Ollama (Local AI Models)
# -----------------------------------------------------------------------------
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------
# Default: http://localhost:3100
MCP_SERVER_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# GitHub App (optional — enables GitHub integration features)
# See app.yml for the GitHub App manifest.
# -----------------------------------------------------------------------------
# Created automatically when you register the app via GitHub:
#   https://github.com/settings/apps/new?manifest=<encoded-manifest>
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# The URL slug of your registered GitHub App (shown in the app's URL on GitHub)
# e.g. if your app is at https://github.com/apps/my-imagination-station, set:
NEXT_PUBLIC_GITHUB_APP_SLUG=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Random secret used for session signing (generate with: openssl rand -hex 32)
AUTH_SECRET=
